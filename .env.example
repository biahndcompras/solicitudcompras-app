# Copiar a .env y completar con los valores de cada entorno.
# NUNCA commitear .env; usar las variables de entorno del proveedor (Vercel) por entorno.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base de datos para migraciones (scripts/db-migrate.sh, db-reset.sh, db-seed.sh)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Resend (correo transaccional)
RESEND_API_KEY=
# Destinatario del correo 1 (RFQ al coordinador) cuando la solicitud no tiene
# coordinador asignado con email. El solicitante NUNCA es el destinatario: ese correo lleva
# el PDF con sus cotizaciones y precios.
MAIL_COORDINADOR_DEFAULT=
# Secreto con el que Vercel firma el cron diario (app/api/cron/recordatorios). Sin él, esa
# ruta queda deshabilitada y responde 503: no queremos una ruta que manda correos, abierta.
CRON_SECRET=
# Debe ser un dominio VERIFICADO en Resend. Con uno sin verificar, Resend acepta la
# llamada y después marca el envío como fallido: el correo nunca sale y el error solo se ve
# en la bitácora `correo_enviado`.
MAIL_FROM=Portal de Compras BIA <no-reply@TU-DOMINIO-VERIFICADO>

# Correo transaccional (sprints posteriores)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# IA — OpenRouter (acceso unificado a múltiples modelos)
OPENROUTER_API_KEY=
# Modelo principal: Gemini 2.5 Flash Lite (barato, visión nativa, 1M contexto)
IA_MODEL=google/gemini-2.5-flash-lite
# Fallback si el principal falla
IA_MODEL_FALLBACK=openai/gpt-4o-mini
# Timeout por función de IA (ms)
IA_TIMEOUT_CLASIFICAR=10000
IA_TIMEOUT_ASSESSMENT=15000
IA_TIMEOUT_EXTRAER=30000
IA_TIMEOUT_COMPARATIVA=25000
IA_TIMEOUT_VALIDAR_FISCAL=10000
